<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Тема запуска: системный splash screen (API 31+) и его бэкпорт из core-splashscreen. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/system_bar</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.App</item>
    </style>

    <!-- Тёмная тема всегда: платформа тёмная, и нативные окна (шторка меню, диалоги)
         должны совпадать с ней, иначе системные панели в них становятся светлыми. -->
    <style name="Theme.App" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/system_bar</item>
    </style>
</resources>
